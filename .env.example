# Copy to .env and replace placeholders. Never commit .env or WhatsApp auth data.
WHATSAPP_AUTH_PATH=./data/whatsapp-auth
WHATSAPP_ALLOWED_USERS=your-number@s.whatsapp.net
WHATSAPP_ALLOWED_CHATS=
WHATSAPP_ALLOW_SELF_MESSAGES=true
AGENT_REMOTE_ROUTES_PATH=./config/routes.json
AGENT_REMOTE_WORKSPACE_ROOTS=../your-project
AGENT_REMOTE_DEFAULT_WORKSPACE=../your-project
AGENT_REMOTE_SESSION_PATH=./data/developer-agent-sessions.json
AGENT_REMOTE_TIMEOUT_MS=120000
AGENT_REMOTE_MAX_OUTPUT_BYTES=65536
AGENT_REMOTE_LOCK_PATH=./data/agent-remote.lock
# Optional absolute executable overrides, useful when a CLI is installed on Windows but the gateway runs in WSL.
# AGENT_REMOTE_CLAUDE_EXECUTABLE=/mnt/c/Users/your-user/.local/bin/claude.exe
# AGENT_REMOTE_CODEX_EXECUTABLE=/mnt/c/Users/your-user/.local/bin/codex.exe
# AGENT_REMOTE_COPILOT_EXECUTABLE=/mnt/c/Users/your-user/.local/bin/copilot.exe
